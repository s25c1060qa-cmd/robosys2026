#!/usr/bin/python3

import sys
from datetime import datetime
from zoneinfo import ZoneInfo

#日本語対応用の辞書
COUNTRIES = {
    "アメリカ": "America/New_York",
    "USA": "America/New_York",
    "ニューヨーク": "America/New_York",
    "ロサンゼルス": "America/Los_Angeles",
    "イギリス": "Europe/London",
    "UK": "Europe/London",
    "ロンドン": "Europe/London",
    "フランス": "Europe/Paris",
    "ドイツ": "Europe/Berlin",
    "韓国": "Asia/Seoul",
    "中国": "Asia/Shanghai",
    "インド": "Asia/Kolkata",
    "オーストラリア": "Australia/Sydney",
}

jst = ZoneInfo("Asia/Tokyo")

for line in sys.stdin:
    name = line.strip()

    if not name:
        continue

    if name in COUNTRIES:
        target_tz = ZoneInfo(COUNTRIES[name])
#一度秒にするため、.total_seconds()を使っています
        timediff = (datetime.now(target_tz).utcoffset() - datetime.now(jst).utcoffset()).total_seconds() / 3600
        print(f"日本との時間の差は：{timediff}時間です。")
#経度が入力されてた時の処理
    else:
        try:
            lon = float(name)

            if lon < -180.0 or lon > 180.0:
                print("エラー: 経度は-180から180の間で入力してください", file=sys.stderr)
                sys.exit(1)

            timediff = (lon - 135.0) / 15.0
            print(f"日本との時間の差は：{timediff:+.1f}時間です。")

        except ValueError:
#辞書にもなくかつ、数字が入力されたわけでもない場合の処理
            print("エラーメッセージ：国名か経度を入力してください", file=sys.stderr)
            sys.exit(1)
