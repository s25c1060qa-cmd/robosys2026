import sys
from datetime import datetime
from zoneinfo import ZoneInfo

COUNTRIES = {
    "アメリカ": "America/New_York",
    "USA": "America/New_York",
    "ニューヨーク": "America/New_York",
    "ロサンゼルス": "America/Los_Angeles",
    "イギリス": "Europe/London",
    "UK": "Europe/London",
    "ロンドン": "Europe/London",
    "フランス": "Europe/Paris",
    "ドイツ": "Europe/Berlin",
    "韓国": "Asia/Seoul",
    "中国": "Asia/Shanghai",
    "インド": "Asia/Kolkata",
    "オーストラリア": "Australia/Sydney",
}

jst = ZoneInfo("Asia/Tokyo")

if len(sys.argv) < 2:
    print("エラー: 引数に国名または経度を指定してください", file=sys.stderr)
    sys.exit(1)

target = sys.argv[1]

if target in COUNTRIES:
    target_tz = ZoneInfo(COUNTRIES[target])
    timediff = (datetime.now(target_tz).utcoffset() - datetime.now(jst).utcoffset()).total_seconds() / 3600
else:
    try:
        lon = float(target)
        if lon < -180.0 or lon > 180.0:
            print("エラー: 経度は-180から180の間で入力してください", file=sys.stderr)
            sys.exit(1)
        timediff = (lon - 135.0) / 15.0
    except ValueError:
        print("エラー: 登録されていない国名か、不正な経度です", file=sys.stderr)
        sys.exit(1)

#標準入力から「日本の時刻」を受け取り、現地時刻の数字を出力
for line in sys.stdin:
    text = line.strip()
    if not text:
        continue

    try:
        japan_hour = float(text)
        if japan_hour < 0.0 or japan_hour > 24.0:
            print("エラー: 時刻は0から24の間で入力してください", file=sys.stderr)
            sys.exit(1)

        # 日本の時刻に時差を足して、24時間表記（0〜24）に直す
        local_hour = (japan_hour + timediff) % 24.0
        print(f"{local_hour:.1f}")

    except ValueError:
        print("エラー: 時刻は数字で入力してください", file=sys.stderr)
        sys.exit(1)
